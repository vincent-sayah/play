{%- set primary = (groups['postgresql_primary'] | first) -%}
{%- set replica = (groups['postgresql_replica'] | first) -%}
{%- set primary_vars = hostvars[primary] -%}
{%- set replica_vars = hostvars[replica] -%}
{%- set primary_facts = primary_vars.get('ansible_facts', {}) -%}
{%- set replica_facts = replica_vars.get('ansible_facts', {}) -%}
{%- set primary_ip = primary_facts.get('default_ipv4', {}).get('address', primary_vars.get('ansible_default_ipv4', {}).get('address', primary_vars.get('ansible_host'))) | mandatory -%}
{%- set replica_ip = replica_facts.get('default_ipv4', {}).get('address', replica_vars.get('ansible_default_ipv4', {}).get('address', replica_vars.get('ansible_host'))) | mandatory -%}
{%- set primary_hostname = primary_vars.get('ansible_hostname', primary_facts.get('hostname', primary_vars.get('ansible_host', primary).split('.')[0])) | mandatory -%}
{%- set replica_hostname = replica_vars.get('ansible_hostname', replica_facts.get('hostname', replica_vars.get('ansible_host', replica).split('.')[0])) | mandatory -%}
{%- set primary_node_name = primary_vars.get('repmgr_node_name', 'node1') -%}
{%- set replica_node_name = replica_vars.get('repmgr_node_name', 'node2') -%}
{%- set primary_node_id = primary_vars.get('repmgr_node_id', '1') -%}
{%- set replica_node_id = replica_vars.get('repmgr_node_id', '2') -%}
{%- if postgresql_pg_major is defined -%}
{%- set pg_version = postgresql_pg_major -%}
{%- elif postgresql_version is defined -%}
{%- set pg_version = (postgresql_version | string).split('.')[0] -%}
{%- else -%}
{%- set pg_version = '17' -%}
{%- endif -%}
{%- if vault_server_pki_domain is defined -%}
{%- set pki_domain = vault_server_pki_domain -%}
{%- elif zone_url is defined -%}
{%- set pki_domain = zone_url -%}
{%- else -%}
{%- set pki_domain = 'picsel.defense.gouv.fr' -%}
{%- endif -%}
#!/bin/bash

set -Eeuo pipefail

################################################################################
# Réintégration d'un ancien primary PostgreSQL en tant que standby
#
# Ce fichier est généré par Ansible à partir de l'inventaire :
#   - groups['postgresql_primary']
#   - groups['postgresql_replica']
#   - hostvars et facts réseau de chaque nœud
#
# V. SAYAH - PPM
################################################################################

PG_VERSION="{{ pg_version }}"
DOMAIN="{{ pki_domain }}"

NODE1_HOSTNAME="{{ primary_hostname }}"
NODE1_IP="{{ primary_ip }}"
NODE1_NAME="{{ primary_node_name }}"
NODE1_ID="{{ primary_node_id }}"

NODE2_HOSTNAME="{{ replica_hostname }}"
NODE2_IP="{{ replica_ip }}"
NODE2_NAME="{{ replica_node_name }}"
NODE2_ID="{{ replica_node_id }}"

PG_SERVICE="postgresql-${PG_VERSION}"
REPMGR_SERVICE="repmgr-${PG_VERSION}"
VAULT_SERVICE="vault-agent"

PG_BIN="/usr/pgsql-${PG_VERSION}/bin"
PSQL="${PG_BIN}/psql"
PG_ISREADY="${PG_BIN}/pg_isready"
POSTGRES_BIN="${PG_BIN}/postgres"
REPMGR_BIN="${PG_BIN}/repmgr"

PGDATA="/var/lib/pgsql/${PG_VERSION}/data"
TBS_DATA="/var/lib/pgsql/${PG_VERSION}/tbs_data"

REPMGR_CONF="/etc/repmgr/${PG_VERSION}/repmgr.conf"
VAULT_AGENT_CONF="/etc/vault.d/vault-agent.hcl"

REPLICATION_USER="{{ postgres_user_repmgr | default('repl') }}"
REPMGR_DATABASE="{{ postgres_bdd_repmgr | default('repmgr') }}"

TIMESTAMP="$(date '+%Y%m%d_%H%M%S')"
BACKUP_DIR="/var/tmp/postgresql-rejoin-${TIMESTAMP}"
LOCK_FILE="/run/configure_cluster_standby.lock"

###############################################################################
# Fonctions
###############################################################################

log() {
    echo
    echo "[$(date '+%F %T')] $*"
}

warning() {
    echo
    echo "ATTENTION : $*" >&2
}

fatal() {
    echo
    echo "ERREUR : $*" >&2
    exit 1
}

as_postgres() {
    sudo -iu postgres "$@"
}

show_diagnostics() {
    echo
    echo "================ DIAGNOSTIC POSTGRESQL ================="
    systemctl status "${PG_SERVICE}" --no-pager -l 2>/dev/null || true
    journalctl -u "${PG_SERVICE}" -n 100 --no-pager 2>/dev/null || true

    echo
    echo "================ DIAGNOSTIC VAULT AGENT ================"
    systemctl status "${VAULT_SERVICE}" --no-pager -l 2>/dev/null || true
    journalctl -u "${VAULT_SERVICE}" -n 100 --no-pager 2>/dev/null || true

    echo
    echo "================ DIAGNOSTIC REPMGR ====================="
    systemctl status "${REPMGR_SERVICE}" --no-pager -l 2>/dev/null || true
    journalctl -u "${REPMGR_SERVICE}" -n 100 --no-pager 2>/dev/null || true
}

on_error() {
    local exit_code=$?
    local line_number=$1

    echo
    echo "ERREUR inattendue à la ligne ${line_number}, code ${exit_code}." >&2
    show_diagnostics
    exit "${exit_code}"
}

wait_for_file() {
    local file="$1"
    local timeout="${2:-180}"
    local elapsed=0

    log "Attente du fichier ${file}"

    while [[ "${elapsed}" -lt "${timeout}" ]]; do
        if [[ -s "${file}" ]]; then
            return 0
        fi

        sleep 2
        elapsed=$((elapsed + 2))
    done

    journalctl -u "${VAULT_SERVICE}" -n 100 --no-pager || true
    fatal "Vault Agent n'a pas généré le fichier ${file}"
}

backup_file() {
    local source_file="$1"

    if [[ -e "${source_file}" ]]; then
        cp -a "${source_file}" "${BACKUP_DIR}/"
    fi
}

trap 'on_error ${LINENO}' ERR

###############################################################################
# Vérifications initiales
###############################################################################

clear

echo "################################################################################"
echo "Réintégration d'un ancien primary PostgreSQL en tant que standby"
echo
echo "Cette opération va :"
echo "  - arrêter PostgreSQL et repmgrd ;"
echo "  - supprimer le contenu du PGDATA local ;"
echo "  - cloner le primary actuellement actif ;"
echo "  - régénérer le certificat Vault propre à ce serveur ;"
echo "  - enregistrer ce serveur comme standby dans repmgr."
echo
echo "V. SAYAH - PPM"
echo "################################################################################"

if [[ "${EUID}" -ne 0 ]]; then
    fatal "Ce script doit être exécuté avec le compte root."
fi

for command in \
    sudo \
    systemctl \
    find \
    install \
    sed \
    openssl \
    sha256sum \
    restorecon \
    grep \
    awk \
    flock
do
    command -v "${command}" >/dev/null 2>&1 ||
        fatal "Commande absente : ${command}"
done

for binary in \
    "${PSQL}" \
    "${PG_ISREADY}" \
    "${POSTGRES_BIN}" \
    "${REPMGR_BIN}"
do
    [[ -x "${binary}" ]] ||
        fatal "Binaire absent ou non exécutable : ${binary}"
done

[[ -f "${REPMGR_CONF}" ]] ||
    fatal "Configuration repmgr absente : ${REPMGR_CONF}"

[[ -f "${VAULT_AGENT_CONF}" ]] ||
    fatal "Configuration Vault Agent absente : ${VAULT_AGENT_CONF}"

exec 9>"${LOCK_FILE}"

if ! flock -n 9; then
    fatal "Une autre exécution du script est déjà en cours."
fi

###############################################################################
# Identification du nœud et du primary attendu
###############################################################################

CURRENT_HOSTNAME="$(hostname -s | tr '[:lower:]' '[:upper:]')"
NODE1_HOSTNAME_UPPER="$(printf '%s' "${NODE1_HOSTNAME}" | tr '[:lower:]' '[:upper:]')"
NODE2_HOSTNAME_UPPER="$(printf '%s' "${NODE2_HOSTNAME}" | tr '[:lower:]' '[:upper:]')"

case "${CURRENT_HOSTNAME}" in
    "${NODE1_HOSTNAME_UPPER}")
        LOCAL_NODE_ID="${NODE1_ID}"
        LOCAL_NODE_NAME="${NODE1_NAME}"

        PRIMARY_HOST="${NODE2_IP}"
        PRIMARY_NODE_NAME="${NODE2_NAME}"
        ;;

    "${NODE2_HOSTNAME_UPPER}")
        LOCAL_NODE_ID="${NODE2_ID}"
        LOCAL_NODE_NAME="${NODE2_NAME}"

        PRIMARY_HOST="${NODE1_IP}"
        PRIMARY_NODE_NAME="${NODE1_NAME}"
        ;;

    *)
        fatal "Hôte inconnu : ${CURRENT_HOSTNAME}"
        ;;
esac

LOCAL_CN="$(printf '%s.%s' "${CURRENT_HOSTNAME}" "${DOMAIN}" | tr '[:upper:]' '[:lower:]')"

SSL_DIR="${PGDATA}/ssl"
SSL_CERT="${SSL_DIR}/${LOCAL_CN}.pem"
SSL_KEY="${SSL_DIR}/${LOCAL_CN}.key"
SSL_CA="${SSL_DIR}/${LOCAL_CN}_ca_chain.pem"

echo
echo "Serveur local            : ${CURRENT_HOSTNAME}"
echo "Nœud local repmgr        : ${LOCAL_NODE_NAME} / ID ${LOCAL_NODE_ID}"
echo "Primary attendu          : ${PRIMARY_NODE_NAME} / ${PRIMARY_HOST}"
echo "CN TLS local             : ${LOCAL_CN}"
echo "PGDATA                   : ${PGDATA}"
echo "Configuration repmgr     : ${REPMGR_CONF}"

###############################################################################
# Contrôle de la configuration Vault locale
###############################################################################

if ! grep -Fq "${LOCAL_CN}" "${VAULT_AGENT_CONF}"; then
    fatal "La configuration Vault Agent ne contient pas le CN local ${LOCAL_CN}."
fi

if ! systemctl is-active --quiet "${VAULT_SERVICE}"; then
    warning "Vault Agent n'est pas actif. Tentative de démarrage."

    systemctl start "${VAULT_SERVICE}"
    sleep 3

    systemctl is-active --quiet "${VAULT_SERVICE}" ||
        fatal "Vault Agent ne démarre pas."
fi

###############################################################################
# Vérification du primary distant
###############################################################################

log "Vérification du primary actuel ${PRIMARY_HOST}"

REMOTE_RECOVERY=""

if ! REMOTE_RECOVERY="$(
    as_postgres "${PSQL}" \
        -h "${PRIMARY_HOST}" \
        -U "${REPLICATION_USER}" \
        -d "${REPMGR_DATABASE}" \
        -AtX \
        -c "SELECT pg_is_in_recovery();" \
        2>/dev/null
)"; then
    fatal "Impossible de se connecter au serveur ${PRIMARY_HOST} avec l'utilisateur ${REPLICATION_USER}."
fi

if [[ "${REMOTE_RECOVERY}" != "f" ]]; then
    fatal "Le serveur ${PRIMARY_HOST} n'est pas primary. pg_is_in_recovery()=${REMOTE_RECOVERY}"
fi

log "Le serveur ${PRIMARY_HOST} est bien le primary actif"

###############################################################################
# Confirmation utilisateur
###############################################################################

echo
echo "ATTENTION : le contenu de ${PGDATA} va être supprimé."
echo "Le serveur sera entièrement reconstruit depuis ${PRIMARY_HOST}."
echo

read -r -p \
    "Confirmer la réintégration de ${CURRENT_HOSTNAME} comme standby ? (oui/non) : " \
    REPLY

if [[ ! "${REPLY}" =~ ^([Oo][Uu][Ii]|[Yy][Ee][Ss])$ ]]; then
    echo "Opération annulée."
    exit 0
fi

###############################################################################
# Arrêt des services locaux
###############################################################################

log "Arrêt du service repmgr"

systemctl stop "${REPMGR_SERVICE}" 2>/dev/null || true

log "Arrêt du service PostgreSQL"

systemctl stop "${PG_SERVICE}"

if systemctl is-active --quiet "${PG_SERVICE}"; then
    fatal "PostgreSQL est toujours actif après la demande d'arrêt."
fi

###############################################################################
# Test du clone
###############################################################################

log "Test du clone repmgr en mode dry-run"

as_postgres "${REPMGR_BIN}" \
    -h "${PRIMARY_HOST}" \
    -U "${REPLICATION_USER}" \
    -d "${REPMGR_DATABASE}" \
    -f "${REPMGR_CONF}" \
    standby clone \
    --copy-external-config-files=pgdata \
    --force \
    --fast-checkpoint \
    --dry-run

###############################################################################
# Sauvegarde de la configuration locale
###############################################################################

log "Sauvegarde de la configuration locale dans ${BACKUP_DIR}"

install \
    -d \
    -o root \
    -g root \
    -m 0700 \
    "${BACKUP_DIR}"

backup_file "${PGDATA}/postgresql.conf"
backup_file "${PGDATA}/postgresql.auto.conf"
backup_file "${PGDATA}/pg_hba.conf"
backup_file "${PGDATA}/pg_ident.conf"
backup_file "${REPMGR_CONF}"
backup_file "${VAULT_AGENT_CONF}"

###############################################################################
# Nettoyage de l'ancien cluster
###############################################################################

log "Arrêt temporaire de Vault Agent"

systemctl stop "${VAULT_SERVICE}"

log "Nettoyage du PGDATA ${PGDATA}"

install \
    -d \
    -o postgres \
    -g postgres \
    -m 0700 \
    "${PGDATA}"

find "${PGDATA}" \
    -mindepth 1 \
    -maxdepth 1 \
    -exec rm -rf -- {} +

log "Nettoyage des tablespaces ${TBS_DATA}"

install \
    -d \
    -o postgres \
    -g postgres \
    -m 0700 \
    "${TBS_DATA}"

find "${TBS_DATA}" \
    -mindepth 1 \
    -maxdepth 1 \
    -exec rm -rf -- {} +

###############################################################################
# Clone depuis le primary
###############################################################################

log "Clonage de PostgreSQL depuis ${PRIMARY_HOST}"

as_postgres "${REPMGR_BIN}" \
    -h "${PRIMARY_HOST}" \
    -U "${REPLICATION_USER}" \
    -d "${REPMGR_DATABASE}" \
    -f "${REPMGR_CONF}" \
    standby clone \
    --copy-external-config-files=pgdata \
    --force \
    --fast-checkpoint

###############################################################################
# Contrôle du clone
###############################################################################

log "Contrôle des fichiers générés par le clone"

for required_file in \
    "${PGDATA}/PG_VERSION" \
    "${PGDATA}/postgresql.conf" \
    "${PGDATA}/postgresql.auto.conf" \
    "${PGDATA}/pg_hba.conf" \
    "${PGDATA}/standby.signal"
do
    [[ -s "${required_file}" ]] ||
        fatal "Fichier absent après le clone : ${required_file}"
done

if grep -nE \
    '^[[:space:]]*include(_dir|_if_exists)?' \
    "${PGDATA}/postgresql.conf"
then
    warning "Des directives include sont présentes dans postgresql.conf. Vérifier leurs chemins."
fi

###############################################################################
# Nettoyage des certificats copiés depuis le primary
###############################################################################

log "Suppression des certificats copiés depuis le primary"

rm -rf -- "${SSL_DIR}"

install \
    -d \
    -o postgres \
    -g postgres \
    -m 0700 \
    "${SSL_DIR}"

restorecon -Rv "${SSL_DIR}" >/dev/null || true

###############################################################################
# Génération du certificat local par Vault
###############################################################################

log "Démarrage de Vault Agent pour générer le certificat local"

systemctl start "${VAULT_SERVICE}"
sleep 3

if ! systemctl is-active --quiet "${VAULT_SERVICE}"; then
    journalctl -u "${VAULT_SERVICE}" -n 100 --no-pager || true
    fatal "Vault Agent n'a pas démarré."
fi

wait_for_file "${SSL_CERT}" 180
wait_for_file "${SSL_KEY}" 180
wait_for_file "${SSL_CA}" 180

###############################################################################
# Vérification du certificat local
###############################################################################

log "Vérification du CN et des SAN du certificat"

CERTIFICATE_DETAILS="$(
    openssl x509 \
        -in "${SSL_CERT}" \
        -noout \
        -subject \
        -ext subjectAltName
)"

echo "${CERTIFICATE_DETAILS}"

if ! echo "${CERTIFICATE_DETAILS}" | grep -Fqi "${LOCAL_CN}"; then
    fatal "Le certificat généré ne contient pas le FQDN local ${LOCAL_CN}."
fi

log "Vérification de la correspondance certificat / clé privée"

CERT_HASH="$(
    openssl x509 \
        -in "${SSL_CERT}" \
        -pubkey \
        -noout |
    openssl pkey \
        -pubin \
        -outform DER |
    sha256sum |
    awk '{print $1}'
)"

KEY_HASH="$(
    openssl pkey \
        -in "${SSL_KEY}" \
        -pubout \
        -outform DER |
    sha256sum |
    awk '{print $1}'
)"

if [[ "${CERT_HASH}" != "${KEY_HASH}" ]]; then
    fatal "Le certificat et la clé privée ne correspondent pas."
fi

###############################################################################
# Permissions TLS compatibles PostgreSQL
###############################################################################

log "Application des permissions TLS"

chown root:postgres \
    "${SSL_CERT}" \
    "${SSL_KEY}" \
    "${SSL_CA}"

chmod 0644 \
    "${SSL_CERT}" \
    "${SSL_CA}"

chmod 0640 "${SSL_KEY}"

restorecon -Rv "${SSL_DIR}" >/dev/null || true

###############################################################################
# Configuration TLS locale
###############################################################################

log "Configuration des chemins TLS locaux dans postgresql.conf"

cp -a \
    "${PGDATA}/postgresql.conf" \
    "${PGDATA}/postgresql.conf.before-local-tls-fix"

sed -ri \
    '/^[[:space:]]*ssl[[:space:]]*=/d;
     /^[[:space:]]*ssl_cert_file[[:space:]]*=/d;
     /^[[:space:]]*ssl_key_file[[:space:]]*=/d;
     /^[[:space:]]*ssl_ca_file[[:space:]]*=/d' \
    "${PGDATA}/postgresql.conf"

cat >> "${PGDATA}/postgresql.conf" <<TLS_EOF

# BEGIN TLS local géré par Vault Agent
ssl = on
ssl_cert_file = '${SSL_CERT}'
ssl_key_file = '${SSL_KEY}'
ssl_ca_file = '${SSL_CA}'
# END TLS local géré par Vault Agent
TLS_EOF

sed -ri \
    '/^[[:space:]]*ssl[[:space:]]*=/d;
     /^[[:space:]]*ssl_cert_file[[:space:]]*=/d;
     /^[[:space:]]*ssl_key_file[[:space:]]*=/d;
     /^[[:space:]]*ssl_ca_file[[:space:]]*=/d' \
    "${PGDATA}/postgresql.auto.conf"

chown postgres:postgres \
    "${PGDATA}/postgresql.conf" \
    "${PGDATA}/postgresql.auto.conf"

chmod 0600 \
    "${PGDATA}/postgresql.conf" \
    "${PGDATA}/postgresql.auto.conf"

restorecon -Rv "${PGDATA}" >/dev/null || true

###############################################################################
# Validation de la configuration avant démarrage
###############################################################################

log "Validation de la configuration PostgreSQL"

EFFECTIVE_SSL="$(
    as_postgres "${POSTGRES_BIN}" \
        -D "${PGDATA}" \
        -C ssl
)"

EFFECTIVE_CERT="$(
    as_postgres "${POSTGRES_BIN}" \
        -D "${PGDATA}" \
        -C ssl_cert_file
)"

EFFECTIVE_KEY="$(
    as_postgres "${POSTGRES_BIN}" \
        -D "${PGDATA}" \
        -C ssl_key_file
)"

EFFECTIVE_CA="$(
    as_postgres "${POSTGRES_BIN}" \
        -D "${PGDATA}" \
        -C ssl_ca_file
)"

echo "ssl           = ${EFFECTIVE_SSL}"
echo "ssl_cert_file = ${EFFECTIVE_CERT}"
echo "ssl_key_file  = ${EFFECTIVE_KEY}"
echo "ssl_ca_file   = ${EFFECTIVE_CA}"

[[ "${EFFECTIVE_SSL}" == "on" ]] ||
    fatal "SSL n'est pas activé."

[[ "${EFFECTIVE_CERT}" == "${SSL_CERT}" ]] ||
    fatal "Chemin ssl_cert_file incorrect : ${EFFECTIVE_CERT}"

[[ "${EFFECTIVE_KEY}" == "${SSL_KEY}" ]] ||
    fatal "Chemin ssl_key_file incorrect : ${EFFECTIVE_KEY}"

[[ "${EFFECTIVE_CA}" == "${SSL_CA}" ]] ||
    fatal "Chemin ssl_ca_file incorrect : ${EFFECTIVE_CA}"

###############################################################################
# Démarrage PostgreSQL
###############################################################################

log "Démarrage de PostgreSQL"

if ! systemctl start "${PG_SERVICE}"; then
    show_diagnostics
    fatal "PostgreSQL n'a pas démarré."
fi

log "Attente de PostgreSQL"

POSTGRES_READY="false"

for _ in $(seq 1 60); do
    if as_postgres "${PG_ISREADY}" -q -t 2; then
        POSTGRES_READY="true"
        break
    fi

    sleep 2
done

if [[ "${POSTGRES_READY}" != "true" ]]; then
    show_diagnostics
    fatal "PostgreSQL ne répond pas après son démarrage."
fi

###############################################################################
# Vérification du rôle standby
###############################################################################

log "Vérification que le serveur est en mode standby"

IN_RECOVERY="$(
    as_postgres "${PSQL}" \
        -AtX \
        -c "SELECT pg_is_in_recovery();"
)"

if [[ "${IN_RECOVERY}" != "t" ]]; then
    fatal "Le serveur a démarré mais n'est pas standby. pg_is_in_recovery()=${IN_RECOVERY}"
fi

###############################################################################
# Vérification de la réplication streaming
###############################################################################

log "Attente de la réplication streaming"

WAL_RECEIVER_STATUS=""

for _ in $(seq 1 60); do
    WAL_RECEIVER_STATUS="$(
        as_postgres "${PSQL}" \
            -AtX \
            -c "SELECT status FROM pg_stat_wal_receiver LIMIT 1;" \
            2>/dev/null || true
    )"

    if [[ "${WAL_RECEIVER_STATUS}" == "streaming" ]]; then
        break
    fi

    sleep 2
done

if [[ "${WAL_RECEIVER_STATUS}" != "streaming" ]]; then
    show_diagnostics
    fatal "Le standby est démarré mais la réplication n'est pas streaming."
fi

log "Réplication streaming active"

###############################################################################
# Enregistrement repmgr
###############################################################################

log "Enregistrement du standby dans repmgr"

as_postgres "${REPMGR_BIN}" \
    -f "${REPMGR_CONF}" \
    standby register \
    --force

###############################################################################
# Démarrage repmgrd
###############################################################################

log "Activation et démarrage de repmgrd"

systemctl enable "${REPMGR_SERVICE}" >/dev/null
systemctl restart "${REPMGR_SERVICE}"

if ! systemctl is-active --quiet "${REPMGR_SERVICE}"; then
    show_diagnostics
    fatal "Le service ${REPMGR_SERVICE} n'est pas actif."
fi

###############################################################################
# Contrôles finaux
###############################################################################

log "État final du cluster repmgr"

as_postgres "${REPMGR_BIN}" \
    -f "${REPMGR_CONF}" \
    cluster show

log "État final des services repmgr"

as_postgres "${REPMGR_BIN}" \
    -f "${REPMGR_CONF}" \
    service status

log "Contrôle final TLS"

TLS_QUERY="SELECT name, setting FROM pg_settings WHERE name IN ('ssl', 'ssl_cert_file', 'ssl_key_file', 'ssl_ca_file') ORDER BY name;"

as_postgres "${PSQL}" \
    -x \
    -c "${TLS_QUERY}"

log "Contrôle final du rôle PostgreSQL"

FINAL_RECOVERY_STATUS="$(
    as_postgres "${PSQL}" \
        -AtX \
        -c "SELECT pg_is_in_recovery();"
)"

if [[ "${FINAL_RECOVERY_STATUS}" != "t" ]]; then
    fatal "Le serveur local n'est plus standby. pg_is_in_recovery()=${FINAL_RECOVERY_STATUS}"
fi

log "Contrôle final de la réplication"

FINAL_WAL_RECEIVER_STATUS="$(
    as_postgres "${PSQL}" \
        -AtX \
        -c "SELECT status FROM pg_stat_wal_receiver LIMIT 1;"
)"

if [[ "${FINAL_WAL_RECEIVER_STATUS}" != "streaming" ]]; then
    fatal "La réplication finale n'est pas streaming : ${FINAL_WAL_RECEIVER_STATUS}"
fi

echo
echo "################################################################################"
echo "Réintégration terminée avec succès."
echo
echo "Serveur         : ${CURRENT_HOSTNAME}"
echo "Rôle            : standby"
echo "Primary         : ${PRIMARY_HOST}"
echo "Réplication     : ${FINAL_WAL_RECEIVER_STATUS}"
echo "Certificat TLS  : ${SSL_CERT}"
echo "Sauvegarde      : ${BACKUP_DIR}"
echo "################################################################################"
