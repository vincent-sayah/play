map $request_uri $kibana_basic {
    # Header auth kibana-proxy
    default "{{ kibana_proxy_auth_header }}";
}

server {
    listen 443 ssl;
    server_name {{ alias_dns_kibana }}.{{ zone_url }};

    ssl_certificate     {{ kibana_cert_path }};
    ssl_certificate_key {{ kibana_key_path }};

    # ---------- PAGE D’ACCUEIL (déconnectée) ----------
    location = / {
        default_type text/html;
        return 200 '<!doctype html><meta charset="utf-8"><title>Kibana</title>
        <body style="font-family:system-ui;margin:0">
         <div style="max-width:560px;margin:12vh auto;padding:24px;border:1px solid #eee;border-radius:12px">
           <h1>Accès Kibana</h1>
           <p>Vous êtes déconnecté.</p>
           <p><a href="/app/home" style="padding:10px 14px;border:1px solid #ddd;border-radius:8px;text-decoration:none"
>Se connecter (SSO)</a></p>
         </div>
        </body>';
    }

    # ---------- oauth2-proxy : sous-requête d'auth_request ----------
    location = /oauth2/auth {
        proxy_set_header X-Real-IP               $remote_addr;
        proxy_set_header X-Scheme                $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
        proxy_set_header X-Original-URI          $request_uri;
        proxy_set_header X-Original-URL          $scheme://$host$request_uri;
        proxy_set_header Cookie                  $http_cookie;

        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        proxy_pass http://{{ http_address_oauth2 }}:{{ port_oauth2 }}/oauth2/auth;
    }

    # Cible pour démarrer le SSO
    location @oauth2_signin {
        return 302 /oauth2/start?rd=$request_uri;
    }

    # ---------- oauth2-proxy : endpoints publics ----------
    location /oauth2/ {
        proxy_pass       http://{{ http_address_oauth2 }}:{{ port_oauth2 }};

        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Scheme   $scheme;
        proxy_set_header Cookie     $http_cookie;

        proxy_buffer_size       64k;
        proxy_buffers           16 64k;
        proxy_busy_buffers_size 128k;
    }

    # ---------- Interception du LOGOUT Kibana ----------
    # Kibana envoie /login?msg=LOGGED_OUT&next=...
    location = /login {
        if ($arg_msg = LOGGED_OUT) {
            # 1) /oauth2/sign_out supprime le cookie _o2p
            # 2) oauth2-proxy appelle backend_logout_url (Keycloak /logout?id_token_hint=...)
            # 3) oauth2-proxy redirige vers rd=/ (page d'accueil)
            return 302 /oauth2/sign_out?rd=/;
        }

        # Pour tout autre /login, on traite comme une URL Kibana normale

        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        error_page 403 = @oauth2_signin;

        auth_request_set $es_runas       $upstream_http_x_auth_request_preferred_username;
        auth_request_set $session_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $session_cookie always;

        proxy_set_header es-security-runas-user $es_runas;
        proxy_set_header X-Forwarded-User       $es_runas;
        proxy_set_header Authorization          $kibana_basic;

        proxy_set_header X-Forwarded-Proto      $scheme;
        proxy_set_header X-Forwarded-For        $proxy_add_x_forwarded_for;
        proxy_set_header Host                   {{ alias_dns_kibana }}.{{ zone_url }};

        proxy_pass https://{{ alias_dns_kibana }}.{{ zone_url }}:{{ server_port_kibana }};

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_ssl_server_name on;
        proxy_ssl_name {{ alias_dns_kibana }}.{{ zone_url }};
        proxy_ssl_verify off;
        proxy_ssl_trusted_certificate {{ kibana_elasticsearch_ca_path }};
    }

    # /logout direct → réutilise la logique Kibana
    location = /logout {
        return 302 /login?msg=LOGGED_OUT;
    }

    # ---------- TOUT LE RESTE : SSO OBLIGATOIRE + KIBANA ----------
    location / {
        auth_request /oauth2/auth;
        error_page 401 = @oauth2_signin;
        error_page 403 = @oauth2_signin;

        auth_request_set $es_runas       $upstream_http_x_auth_request_preferred_username;
        auth_request_set $session_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $session_cookie always;

        proxy_set_header es-security-runas-user $es_runas;
        proxy_set_header X-Forwarded-User       $es_runas;
        proxy_set_header Authorization          $kibana_basic;

        proxy_set_header X-Forwarded-Proto      $scheme;
        proxy_set_header X-Forwarded-For        $proxy_add_x_forwarded_for;
        proxy_set_header Host                   {{ alias_dns_kibana }}.{{ zone_url }};

        proxy_pass https://{{ alias_dns_kibana }}.{{ zone_url }}:{{ server_port_kibana }};

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_ssl_server_name on;
        proxy_ssl_name {{ alias_dns_kibana }}.{{ zone_url }} ;
        proxy_ssl_verify off;
        proxy_ssl_trusted_certificate {{ kibana_elasticsearch_ca_path }};
    }
}
